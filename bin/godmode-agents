#!/usr/bin/env bash
# godmode-agents — generate AGENTS.md, the cross-tool (Codex/Cursor/OpenCode)
# export of the claude-godmode agent roster + engineering rules.
#
# A foreign harness with no claude-godmode plugin installed can read the
# generated AGENTS.md standalone: it names the workflow spine, lists every
# agent with its description, and inlines the full engineering rule set.
#
# Usage:
#   godmode-agents              # write AGENTS.md to the repo root (default)
#   godmode-agents --stdout     # write the same content to stdout, touch no file
#
# Output-path interface (for the drift gate): pass --stdout to regenerate the
# document without clobbering the tracked AGENTS.md, e.g.
#   diff <(godmode-agents --stdout) AGENTS.md
# A clean diff means AGENTS.md is in sync with its sources.
#
# Determinism: content is driven entirely by sorted globs over agents/*.md and
# rules/godmode-*.md. There are NO timestamps, hostnames, or run-varying
# values, so two consecutive runs produce byte-identical output.
#
# Bash 3.2 compatible. No mapfile/readarray, no [[ -v ]], no ${var,,},
# no associative arrays, no GNU-only flags. Any in-place edits would use the
# BSD-safe sed pattern.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT_FILE="${REPO_ROOT}/AGENTS.md"

usage() {
  echo "usage: godmode-agents [--stdout]" >&2
}

# frontmatter_value <file> <key> — print the value of "key:" from the first
# --- ... --- block. Uses the first colon as the separator so values that
# themselves contain colons (e.g. quoted descriptions) survive intact.
# Surrounding single/double quotes are stripped.
frontmatter_value() {
  local file="$1"
  local key="$2"
  awk -v key="$key" '
    NR == 1 && $0 == "---" { inblock = 1; next }
    inblock && $0 == "---" { exit }
    inblock {
      pos = index($0, ":")
      if (pos > 0) {
        k = substr($0, 1, pos - 1)
        if (k == key) {
          v = substr($0, pos + 1)
          gsub(/^[[:space:]]+/, "", v)
          gsub(/[[:space:]]+$/, "", v)
          # strip a matching pair of surrounding quotes
          if (v ~ /^".*"$/ || v ~ /^'\''.*'\''$/) {
            v = substr(v, 2, length(v) - 2)
          }
          print v
          exit
        }
      }
    }
  ' "$file"
}

# emit_intro — project framing + the literal workflow spine.
emit_intro() {
  cat <<'EOF'
# AGENTS.md

This file is the cross-tool export of the **claude-godmode** agent roster and
engineering rules. It is generated by `bin/godmode-agents` and is meant to be
read standalone by any AI coding harness (Codex, Cursor, OpenCode, and others)
that does not have the claude-godmode plugin installed.

The claude-godmode workflow spine is:

`/godmode → /mission → /brief → /plan → /build → /verify → /ship`

Each stage hands off to the next: `/godmode` orients, `/mission` frames the
goal, `/brief` specifies what and why, `/plan` decomposes into steps, `/build`
implements one step at a time behind quality gates, `/verify` checks the brief's
acceptance criteria, and `/ship` lands the change. The agents below are the
specialists this spine delegates to; the rules below are the engineering
standards every agent and stage upholds.

This document is generated — do not edit it by hand. Run `bin/godmode-agents`
to regenerate it from `agents/*.md` and `rules/godmode-*.md`.
EOF
}

# emit_roster — one entry per agents/*.md, in sorted glob order.
emit_roster() {
  echo ""
  echo "## Agent roster"
  echo ""
  echo "These are the specialist agents the workflow spine delegates to."
  echo ""
  local file name description
  for file in "${REPO_ROOT}"/agents/*.md; do
    [ -f "$file" ] || continue
    name="$(frontmatter_value "$file" "name")"
    description="$(frontmatter_value "$file" "description")"
    if [ -z "$name" ]; then
      name="$(basename "$file" .md)"
    fi
    echo "### ${name}"
    echo ""
    if [ -n "$description" ]; then
      echo "${description}"
    fi
    echo ""
  done
}

# emit_rules — full verbatim body of each rules/godmode-*.md, sorted glob order.
emit_rules() {
  echo "## Engineering rules (from godmode)"
  echo ""
  echo "The complete engineering rule set, inlined verbatim from"
  echo "\`rules/godmode-*.md\`. These apply to every agent and every stage."
  echo ""
  local file base
  for file in "${REPO_ROOT}"/rules/godmode-*.md; do
    [ -f "$file" ] || continue
    base="$(basename "$file" .md)"
    echo "### ${base}"
    echo ""
    cat "$file"
    echo ""
  done
}

generate() {
  emit_intro
  emit_roster
  emit_rules
}

main() {
  case "${1:-}" in
    "")
      generate > "$OUT_FILE"
      ;;
    --stdout)
      generate
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
