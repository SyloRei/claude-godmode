#!/usr/bin/env bash
# godmode-state — single source of truth for project workflow state.
# Reads/writes three values persisted in .planning/STATE.md so the
# active-unit number, status, and next-command pointer never drift.
#
# Usage:
#   godmode-state get <key>
#   godmode-state set <key> <value>
#   godmode-state done add <step>
#   godmode-state done has <step>
#   godmode-state done list
#
# Keys: active_unit | status | next_command | mission_id | mission_name
#
# The done-set (steps completed for the active unit) is encoded INSIDE the
# `status` value after a " | done: " marker, e.g. "building 5 | done: S1,S2".
# This preserves the three-key state invariant — there is no fourth key.
#
# Bash 3.2 compatible. No mapfile/readarray, no [[ -v ]], no ${var,,},
# no associative arrays, no GNU-only flags. In-place edits use the
# BSD-safe pattern: sed -i.bak 'EXPR' file && rm -f file.bak.

set -euo pipefail

STATE_DIR=".planning"
STATE_FILE="${STATE_DIR}/STATE.md"

usage() {
  echo "usage: godmode-state get <key>" >&2
  echo "       godmode-state set <key> <value>" >&2
  echo "       godmode-state done add <step>" >&2
  echo "       godmode-state done has <step>" >&2
  echo "       godmode-state done list" >&2
  echo "keys:  active_unit | status | next_command | mission_id | mission_name" >&2
}

# Marker that separates the status label from the encoded done-set.
DONE_MARKER=" | done: "

# Validate that a key is one of the supported state keys.
valid_key() {
  case "$1" in
    active_unit|status|next_command|mission_id|mission_name) return 0 ;;
    *) return 1 ;;
  esac
}

# Create the state file (and its directory) if absent. Idempotent.
ensure_state_file() {
  if [ ! -f "$STATE_FILE" ]; then
    mkdir -p "$STATE_DIR"
    {
      echo "# Project State"
      echo ""
      echo "active_unit:"
      echo "status:"
      echo "next_command:"
    } > "$STATE_FILE"
  fi
}

# get <key> — print the value, or empty string if file/key absent. Never errors.
cmd_get() {
  local key="$1"
  if [ ! -f "$STATE_FILE" ]; then
    return 0
  fi
  # Match "key:" at line start, strip the prefix and surrounding whitespace.
  local line
  line=$(grep "^${key}:" "$STATE_FILE" | head -1 || true)
  if [ -z "$line" ]; then
    return 0
  fi
  # Remove "key:" prefix, then trim leading/trailing whitespace.
  printf '%s\n' "${line#"${key}":}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# set <key> <value> — upsert the key in the state file.
cmd_set() {
  local key="$1"
  local value="$2"
  # State values are single-line key: value pairs. Collapse any newlines to
  # spaces so a multi-line value cannot break the sed s/// command (which
  # would abort the calling script under set -euo pipefail).
  value="$(printf '%s' "$value" | tr '\n' ' ')"
  ensure_state_file

  if grep -q "^${key}:" "$STATE_FILE"; then
    # Escape characters special to sed's replacement text: \ & / and newlines.
    local esc
    esc=$(printf '%s' "$value" | sed -e 's/[\/&\\]/\\&/g')
    sed -i.bak "s/^${key}:.*/${key}: ${esc}/" "$STATE_FILE" && rm -f "${STATE_FILE}.bak"
  else
    printf '%s: %s\n' "$key" "$value" >> "$STATE_FILE"
  fi
}

# done_list_of <status> — print the comma-separated done-set encoded in a
# status value (the portion after DONE_MARKER), or empty if no marker present.
done_list_of() {
  local status="$1"
  case "$status" in
    *"$DONE_MARKER"*)
      # Strip everything up to and including the first marker occurrence.
      printf '%s' "${status#*"$DONE_MARKER"}"
      ;;
    *) ;;
  esac
}

# done_label_of <status> — print the label prefix that precedes DONE_MARKER,
# or the whole status if no marker is present.
done_label_of() {
  local status="$1"
  case "$status" in
    *"$DONE_MARKER"*)
      printf '%s' "${status%%"$DONE_MARKER"*}"
      ;;
    *) printf '%s' "$status" ;;
  esac
}

# done add <step> — add <step> to the done-set inside `status` (idempotent),
# preserving the label prefix. done has <step> — exit 0 if member, else 1.
# done list — print the comma-separated done-set.
cmd_done() {
  local action="$1"
  local status list label step
  status="$(cmd_get status)"
  list="$(done_list_of "$status")"

  case "$action" in
    list)
      printf '%s\n' "$list"
      ;;
    has)
      step="$2"
      case ",${list}," in
        *",${step},"*) exit 0 ;;
        *) exit 1 ;;
      esac
      ;;
    add)
      step="$2"
      # Idempotent: skip if already a member (comma-wrapped match).
      case ",${list}," in
        *",${step},"*) return 0 ;;
      esac
      if [ -z "$list" ]; then
        list="$step"
      else
        list="${list},${step}"
      fi
      label="$(done_label_of "$status")"
      # An empty label would write a leading-space status (" | done: ...") whose
      # marker is then lost to cmd_get's whitespace trim, silently breaking the
      # done-set round-trip (done has/list would read an empty set). Default to a
      # non-empty sentinel so the marker always survives. The spine always sets
      # "building <N>" first; this only guards an out-of-order call.
      [ -n "$label" ] || label="building"
      cmd_set status "${label}${DONE_MARKER}${list}"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main() {
  if [ "$#" -lt 1 ]; then
    usage
    exit 1
  fi

  local sub="$1"
  shift

  case "$sub" in
    get)
      if [ "$#" -ne 1 ]; then usage; exit 1; fi
      if ! valid_key "$1"; then
        echo "error: unknown key '$1'" >&2
        usage
        exit 1
      fi
      cmd_get "$1"
      ;;
    set)
      if [ "$#" -ne 2 ]; then usage; exit 1; fi
      if ! valid_key "$1"; then
        echo "error: unknown key '$1'" >&2
        usage
        exit 1
      fi
      cmd_set "$1" "$2"
      ;;
    done)
      if [ "$#" -lt 1 ]; then usage; exit 1; fi
      local action="$1"
      shift
      case "$action" in
        add|has)
          if [ "$#" -ne 1 ]; then usage; exit 1; fi
          cmd_done "$action" "$1"
          ;;
        list)
          if [ "$#" -ne 0 ]; then usage; exit 1; fi
          cmd_done list
          ;;
        *)
          usage
          exit 1
          ;;
      esac
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
