#!/usr/bin/env bash
# godmode-findings — per-brief findings store.
# Manages a FINDINGS.md markdown table inside a given brief directory.
# Each finding has an ID (F1, F2, …), a lens, severity, confidence,
# status, location, and a note (percent-encoded to survive the table).
#
# Usage:
#   godmode-findings init       <brief_dir>
#   godmode-findings add        <brief_dir> <lens> <sev> <conf> <location> <note>
#   godmode-findings transition <brief_dir> <ID> <open|fixed>
#   godmode-findings waive      <brief_dir> <ID> <reason>
#   godmode-findings list       <brief_dir> [--open] [--blocking] [--decode]
#   godmode-findings count      <brief_dir> --blocking
#   godmode-findings reconcile  <brief_dir>                   # reads batch from stdin
#
# The FINDINGS.md table columns (in order):
#   ID | lens | sev | conf | status | location | note
#
# All free-text columns (lens, location, note) are percent-encoded on write
# (% → %25, | → %7C, newline → %0A) so raw pipe characters or newlines can
# never break the table parser or forge extra rows.
# Enumerated columns (sev, conf) are validated against an allow-list on write
# and rejected with exit 1 if out-of-range.
#
# Match key for dedup = sha1( lens + 0x1F + basename(location) + 0x1F + normalised_note )
# where normalised_note = decoded note lowercased and whitespace-collapsed.
# Line number is intentionally excluded from the match key so the same
# finding at a shifted line is treated as the same finding.
# Match key is computed from DECODED lens/location/note so identity is
# encoding-transparent.
#
# Atomic writes: every mutation writes to <brief_dir>/.FINDINGS.tmp.<PID>
# then mv-renames over FINDINGS.md (same device → atomic).
#
# Bash 3.2 compatible. No mapfile/readarray, no [[ -v ]], no ${var,,},
# no ${var^^}, no associative arrays (declare -A), no GNU-only flags.
# Uses tr for case conversion (not ${var,,}) and awk for cross-platform
# newline handling in encode_note.
# In-place edits use the BSD-safe pattern: sed -i.bak 'EXPR' file && rm -f file.bak.

set -euo pipefail

# Global temp-file path used by the EXIT trap.  Each mutation function sets
# this before creating the file so the trap can clean it up on unexpected exit.
# The function clears it after a successful mv so the trap is a no-op on the
# normal path.  Using a global avoids the bash 3.2 issue where a trap set
# inside a function fires at script exit, when the local variable is gone.
_FINDINGS_TMP=""
trap 'rm -f "$_FINDINGS_TMP"' EXIT

FINDINGS_FILE="FINDINGS.md"
HEADER_ROW="| ID | lens | sev | conf | status | location | note |"
SEP_ROW="|---|---|---|---|---|---|---|"

# ---------------------------------------------------------------------------
# usage
# ---------------------------------------------------------------------------
usage() {
  echo "usage: godmode-findings init       <brief_dir>" >&2
  echo "       godmode-findings add        <brief_dir> <lens> <sev> <conf> <location> <note>" >&2
  echo "       godmode-findings transition <brief_dir> <ID> <open|fixed>" >&2
  echo "       godmode-findings waive      <brief_dir> <ID> <reason>" >&2
  echo "       godmode-findings list       <brief_dir> [--open] [--blocking] [--decode]" >&2
  echo "       godmode-findings count      <brief_dir> --blocking" >&2
  echo "       godmode-findings reconcile  <brief_dir>  # reads tab-delimited batch from stdin" >&2
}

# ---------------------------------------------------------------------------
# Percent-encoding helpers
# Encode ORDER is LOAD-BEARING:
#   1. % → %25  (must be first so we don't double-encode later replacements)
#   2. | → %7C
#   3. newline → %0A  (awk handles multi-line input portably on BSD+GNU)
# Decode is the strict reverse:
#   1. %0A → newline
#   2. %7C → |
#   3. %25 → %  (must be last)
# ---------------------------------------------------------------------------
encode_note() {
  # Use awk so multi-line notes work identically on BSD/macOS and GNU/Linux.
  # ORS="" suppresses awk's own newlines; we emit the literal string %0A
  # between input lines.  Use print with a string literal to avoid awk
  # treating %0A as a printf format specifier.
  printf '%s' "$1" | awk 'BEGIN{ORS=""} {gsub(/%/,"%25"); gsub(/\|/,"%7C"); if(NR>1) print "%0A"; printf "%s",$0}'
}

decode_note() {
  # BSD-safe sed: avoid the GNU -e 's/\n//' form.  Use awk for the %0A step.
  printf '%s' "$1" \
    | awk '{gsub(/%0A/,"\n"); printf "%s",$0}' \
    | sed 's/%7C/|/g' \
    | sed 's/%25/%/g'
}

# ---------------------------------------------------------------------------
# SHA-1 tool — resolved once at first call, cached in SHA1_CMD.
# ---------------------------------------------------------------------------
SHA1_CMD=""
resolve_sha1() {
  if [ -n "$SHA1_CMD" ]; then
    return 0
  fi
  if command -v shasum > /dev/null 2>&1; then
    SHA1_CMD="shasum -a 1"
  elif command -v sha1sum > /dev/null 2>&1; then
    SHA1_CMD="sha1sum"
  else
    echo "error: neither 'shasum' nor 'sha1sum' found; cannot compute match keys" >&2
    exit 1
  fi
}

# validate_sev <sev> — reject out-of-range severity values.
validate_sev() {
  case "$1" in
    CRITICAL|WARNING|NIT|INFO) return 0 ;;
    *)
      printf "error: sev '%s' not in {CRITICAL,WARNING,NIT,INFO}\n" "$1" >&2
      exit 1
      ;;
  esac
}

# validate_conf <conf> — reject out-of-range confidence values.
validate_conf() {
  case "$1" in
    HIGH|MEDIUM|LOW) return 0 ;;
    *)
      printf "error: conf '%s' not in {HIGH,MEDIUM,LOW}\n" "$1" >&2
      exit 1
      ;;
  esac
}

# match_key <lens> <location> <note>
# All three arguments are DECODED (raw) text — never encoded.
# The line number in location is intentionally EXCLUDED from the key so that
# the same finding reported at a shifted line is treated as the same finding.
# We take basename(location) then strip any trailing ":NNN" line-number suffix.
match_key() {
  local lens="$1"
  local location="$2"
  local raw_note="$3"
  local base_loc file_only
  base_loc=$(basename "$location")
  # Strip trailing colon-plus-digits (line number suffix), e.g. "foo.ts:42" → "foo.ts".
  file_only=$(printf '%s' "$base_loc" | sed 's/:[0-9][0-9]*$//')
  # Normalise note: lowercase → whitespace-collapse → trim.
  local norm_note
  norm_note=$(printf '%s' "$raw_note" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -s '[:space:]' ' ' \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  # Unit separator 0x1F between fields.
  local payload
  payload=$(printf '%s\037%s\037%s' "$lens" "$file_only" "$norm_note")
  resolve_sha1
  printf '%s' "$payload" | $SHA1_CMD | awk '{print $1}'
}

# ---------------------------------------------------------------------------
# row_match_key <row>
# Compute the match key for a data row.
#
# Strip the " [waived: <enc_reason>]" suffix on the ENCODED note (before
# decoding) so the strip is always single-line and cannot be confused by a
# reason that contains a percent-encoded newline (%0A).  Stripping on the
# encoded form is safe because the suffix delimiter (" [waived: " and "]")
# only contains ASCII characters that are not percent-encoded, and the
# encoded reason itself never contains a literal "]" (it would be left as-is
# since "]" has no percent-encoding in our scheme — but to be safe the reason
# goes through encode_note which encodes %, |, and newline only; a raw "]" in
# the reason is therefore possible.  We strip greedily (last "]") so a reason
# that contains "]" is handled correctly.
#
# Decode lens and location (now encoded at rest) before passing to match_key.
# ---------------------------------------------------------------------------
row_match_key() {
  local rrow="$1"
  local renc_lens rlens renc_loc rloc renc rnote_stripped
  renc_lens=$(row_field "$rrow" 3)
  rlens=$(decode_note "$renc_lens")
  renc_loc=$(row_field "$rrow" 7)
  rloc=$(decode_note "$renc_loc")
  renc=$(row_field "$rrow" 8)
  # Strip " [waived: ...]" suffix on the ENCODED note — single-line, safe.
  # Use sed with a greedy match on the LAST "]" to handle reasons containing "]".
  rnote_stripped=$(printf '%s' "$renc" | sed 's/ \[waived: .*\]$//')
  # Now decode the stripped note for match_key (which expects decoded text).
  local rrawn
  rrawn=$(decode_note "$rnote_stripped")
  match_key "$rlens" "$rloc" "$rrawn"
}

# ---------------------------------------------------------------------------
# findings_file <brief_dir> — print the path to FINDINGS.md
# ---------------------------------------------------------------------------
findings_file() {
  printf '%s/%s' "$1" "$FINDINGS_FILE"
}

# ---------------------------------------------------------------------------
# next_id <brief_dir> — print the next Fn ID (e.g. F3).
# Reads all ID-column values and returns max+1.  Empty table → F1.
# ---------------------------------------------------------------------------
next_id() {
  local ffile
  ffile=$(findings_file "$1")
  local max=0
  local id_val num
  # grep may return nothing if no data rows; || true prevents set -e abort.
  while IFS= read -r id_val; do
    # Strip leading/trailing whitespace and the 'F' prefix.
    id_val=$(printf '%s' "$id_val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    case "$id_val" in
      F[0-9]*)
        num=${id_val#F}
        if [ "$num" -gt "$max" ] 2>/dev/null; then
          max="$num"
        fi
        ;;
    esac
  done < <(grep -v '^|[-| ]*$' "$ffile" 2>/dev/null | grep '^|' | grep -v '^ *| *ID' | cut -d'|' -f2 || true)
  printf 'F%d\n' "$((max + 1))"
}

# ---------------------------------------------------------------------------
# read_data_rows <brief_dir> — print only the data rows (no header, no sep).
# Each line is a raw table row like "| F1 | lens | ... |".
# ---------------------------------------------------------------------------
read_data_rows() {
  local ffile
  ffile=$(findings_file "$1")
  if [ ! -f "$ffile" ]; then
    return 0
  fi
  # Skip the header row (contains " ID ") and the separator row (contains ---).
  grep '^|' "$ffile" \
    | grep -v '^ *| *ID *|' \
    | grep -v '^|[-| ]*$' \
    || true
}

# ---------------------------------------------------------------------------
# parse_row <row> — extract fields from a table row.
# Prints one field per line in column order: ID lens sev conf status location note
# Field 2=ID, 3=lens, 4=sev, 5=conf, 6=status, 7=location, 8=note (f8 = last visible)
# We use cut -d'|' since notes are encoded (no raw |).
# ---------------------------------------------------------------------------
row_field() {
  local row="$1"
  local n="$2"
  printf '%s' "$row" | cut -d'|' -f"$n" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# ---------------------------------------------------------------------------
# cmd_init <brief_dir>
# ---------------------------------------------------------------------------
cmd_init() {
  if [ "$#" -ne 1 ]; then usage; exit 1; fi
  local brief_dir="$1"
  local ffile
  ffile=$(findings_file "$brief_dir")

  if [ ! -d "$brief_dir" ]; then
    echo "error: brief_dir '$brief_dir' does not exist" >&2
    exit 1
  fi

  # Idempotent: only create if absent.
  if [ -f "$ffile" ]; then
    return 0
  fi

  {
    echo "$HEADER_ROW"
    echo "$SEP_ROW"
  } > "$ffile"
}

# ---------------------------------------------------------------------------
# cmd_add <brief_dir> <lens> <sev> <conf> <location> <note>
# ---------------------------------------------------------------------------
cmd_add() {
  if [ "$#" -ne 6 ]; then usage; exit 1; fi
  local brief_dir="$1"
  local lens="$2"
  local sev="$3"
  local conf="$4"
  local location="$5"
  local note="$6"
  local ffile
  ffile=$(findings_file "$brief_dir")

  if [ ! -f "$ffile" ]; then
    echo "error: FINDINGS.md not found in '$brief_dir'; run 'init' first" >&2
    exit 1
  fi

  # Validate enumerated columns.
  validate_sev "$sev"
  validate_conf "$conf"

  # Compute the match key on the raw (decoded) inputs — lens/location/note are
  # plain text at this point (not yet encoded).
  local mkey
  mkey=$(match_key "$lens" "$location" "$note")

  # Check whether an identical finding (by match key) already exists.
  # row_match_key decodes lens/location/note from the stored encoded form before
  # hashing, so the comparison is encoding-transparent.
  local existing_id=""
  local row
  while IFS= read -r row; do
    local row_key row_id
    row_id=$(row_field "$row" 2)
    row_key=$(row_match_key "$row")
    if [ "$row_key" = "$mkey" ]; then
      existing_id="$row_id"
      break
    fi
  done < <(read_data_rows "$brief_dir")

  if [ -n "$existing_id" ]; then
    printf '%s\n' "$existing_id"
    return 0
  fi

  # Allocate the next ID.
  local new_id
  new_id=$(next_id "$brief_dir")

  # Encode all free-text columns.
  local enc_lens enc_location enc_note
  enc_lens=$(encode_note "$lens")
  enc_location=$(encode_note "$location")
  enc_note=$(encode_note "$note")

  # Build the new row.  sev and conf are validated allow-list values — no encoding needed.
  local new_row
  new_row="| ${new_id} | ${enc_lens} | ${sev} | ${conf} | open | ${enc_location} | ${enc_note} |"

  # Atomic write: append new row to a temp file, then mv over the original.
  # _FINDINGS_TMP is global so the EXIT trap can clean it up on unexpected exit.
  _FINDINGS_TMP="${brief_dir}/.FINDINGS.tmp.$$"

  {
    cat "$ffile"
    echo "$new_row"
  } > "$_FINDINGS_TMP"
  mv "$_FINDINGS_TMP" "$ffile"
  _FINDINGS_TMP=""

  printf '%s\n' "$new_id"
}

# ---------------------------------------------------------------------------
# cmd_transition <brief_dir> <ID> <open|fixed>
# ---------------------------------------------------------------------------
cmd_transition() {
  if [ "$#" -ne 3 ]; then usage; exit 1; fi
  local brief_dir="$1"
  local target_id="$2"
  local new_status="$3"
  local ffile
  ffile=$(findings_file "$brief_dir")

  case "$new_status" in
    open|fixed) ;;
    *)
      echo "error: status must be 'open' or 'fixed'" >&2
      exit 1
      ;;
  esac

  if [ ! -f "$ffile" ]; then
    echo "error: FINDINGS.md not found in '$brief_dir'" >&2
    exit 1
  fi

  # Verify the ID exists.
  local found=0
  local row
  while IFS= read -r row; do
    local row_id
    row_id=$(row_field "$row" 2)
    if [ "$row_id" = "$target_id" ]; then
      found=1
      break
    fi
  done < <(read_data_rows "$brief_dir")

  if [ "$found" -eq 0 ]; then
    echo "error: ID '$target_id' not found in FINDINGS.md" >&2
    exit 1
  fi

  # Rebuild the table, updating the matching row's status field (col 6).
  # _FINDINGS_TMP is global so the EXIT trap can clean it up on unexpected exit.
  _FINDINGS_TMP="${brief_dir}/.FINDINGS.tmp.$$"

  while IFS= read -r row; do
    local row_id
    # Detect header / separator rows and pass them through unchanged.
    case "$row" in
      *" ID "*|*"---|"*)
        echo "$row"
        continue
        ;;
    esac
    row_id=$(row_field "$row" 2)
    if [ "$row_id" = "$target_id" ]; then
      # Reconstruct the row with the new status (field 6).
      local f2 f3 f4 f5 f7 f8
      f2=$(row_field "$row" 2)
      f3=$(row_field "$row" 3)
      f4=$(row_field "$row" 4)
      f5=$(row_field "$row" 5)
      f7=$(row_field "$row" 7)
      f8=$(row_field "$row" 8)
      echo "| ${f2} | ${f3} | ${f4} | ${f5} | ${new_status} | ${f7} | ${f8} |"
    else
      echo "$row"
    fi
  done < "$ffile" > "$_FINDINGS_TMP"
  mv "$_FINDINGS_TMP" "$ffile"
  _FINDINGS_TMP=""
}

# ---------------------------------------------------------------------------
# cmd_waive <brief_dir> <ID> <reason>
# ---------------------------------------------------------------------------
cmd_waive() {
  if [ "$#" -ne 3 ]; then usage; exit 1; fi
  local brief_dir="$1"
  local target_id="$2"
  local reason="$3"
  local ffile
  ffile=$(findings_file "$brief_dir")

  if [ -z "$reason" ]; then
    echo "error: waive reason must not be empty" >&2
    exit 1
  fi

  if [ ! -f "$ffile" ]; then
    echo "error: FINDINGS.md not found in '$brief_dir'" >&2
    exit 1
  fi

  # Verify the ID exists.
  local found=0
  local row
  while IFS= read -r row; do
    local row_id
    row_id=$(row_field "$row" 2)
    if [ "$row_id" = "$target_id" ]; then
      found=1
      break
    fi
  done < <(read_data_rows "$brief_dir")

  if [ "$found" -eq 0 ]; then
    echo "error: ID '$target_id' not found in FINDINGS.md" >&2
    exit 1
  fi

  # Encode the reason and build the waive suffix: " [waived: <reason>]"
  local enc_reason
  enc_reason=$(encode_note "$reason")
  local waive_suffix=" [waived: ${enc_reason}]"

  # Rebuild the table, updating the matching row.
  # _FINDINGS_TMP is global so the EXIT trap can clean it up on unexpected exit.
  _FINDINGS_TMP="${brief_dir}/.FINDINGS.tmp.$$"

  while IFS= read -r row; do
    local row_id
    case "$row" in
      *" ID "*|*"---|"*)
        echo "$row"
        continue
        ;;
    esac
    row_id=$(row_field "$row" 2)
    if [ "$row_id" = "$target_id" ]; then
      local f2 f3 f4 f5 f7 f8
      f2=$(row_field "$row" 2)
      f3=$(row_field "$row" 3)
      f4=$(row_field "$row" 4)
      f5=$(row_field "$row" 5)
      f7=$(row_field "$row" 7)
      f8=$(row_field "$row" 8)
      echo "| ${f2} | ${f3} | ${f4} | ${f5} | waived | ${f7} | ${f8}${waive_suffix} |"
    else
      echo "$row"
    fi
  done < "$ffile" > "$_FINDINGS_TMP"
  mv "$_FINDINGS_TMP" "$ffile"
  _FINDINGS_TMP=""
}

# ---------------------------------------------------------------------------
# cmd_list <brief_dir> [--open] [--blocking] [--decode]
# ---------------------------------------------------------------------------
cmd_list() {
  if [ "$#" -lt 1 ]; then usage; exit 1; fi
  local brief_dir="$1"
  shift

  local filter_open=0
  local filter_blocking=0
  local do_decode=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --open)     filter_open=1     ;;
      --blocking) filter_blocking=1 ;;
      --decode)   do_decode=1       ;;
      *)
        echo "error: unknown flag '$1'" >&2
        usage
        exit 1
        ;;
    esac
    shift
  done

  local row
  while IFS= read -r row; do
    local row_id row_lens row_sev row_conf row_status row_loc row_note
    row_id=$(row_field "$row" 2)
    row_lens=$(row_field "$row" 3)
    row_sev=$(row_field "$row" 4)
    row_conf=$(row_field "$row" 5)
    row_status=$(row_field "$row" 6)
    row_loc=$(row_field "$row" 7)
    row_note=$(row_field "$row" 8)

    # Apply --open filter.
    if [ "$filter_open" -eq 1 ] && [ "$row_status" != "open" ]; then
      continue
    fi

    # Apply --blocking filter: open AND (sev==CRITICAL OR conf==HIGH).
    if [ "$filter_blocking" -eq 1 ]; then
      if [ "$row_status" != "open" ]; then
        continue
      fi
      case "$row_sev:$row_conf" in
        CRITICAL:*|*:HIGH) ;;
        *) continue ;;
      esac
    fi

    # Optionally decode the free-text columns for human-readable output.
    if [ "$do_decode" -eq 1 ]; then
      local display_lens display_loc display_note
      display_lens=$(decode_note "$row_lens")
      display_loc=$(decode_note "$row_loc")
      display_note=$(decode_note "$row_note")
      echo "| ${row_id} | ${display_lens} | ${row_sev} | ${row_conf} | ${row_status} | ${display_loc} | ${display_note} |"
    else
      echo "| ${row_id} | ${row_lens} | ${row_sev} | ${row_conf} | ${row_status} | ${row_loc} | ${row_note} |"
    fi
  done < <(read_data_rows "$brief_dir")
}

# ---------------------------------------------------------------------------
# cmd_count <brief_dir> --blocking
# ---------------------------------------------------------------------------
cmd_count() {
  if [ "$#" -ne 2 ]; then usage; exit 1; fi
  local brief_dir="$1"
  local flag="$2"

  if [ "$flag" != "--blocking" ]; then
    echo "error: count requires --blocking flag" >&2
    usage
    exit 1
  fi

  local n=0
  local row
  while IFS= read -r row; do
    n=$((n + 1))
  done < <(cmd_list "$brief_dir" --blocking)
  printf '%d\n' "$n"
}

# ---------------------------------------------------------------------------
# cmd_reconcile <brief_dir>
# Reads a tab-delimited batch from stdin (one finding per line):
#   lens <TAB> sev <TAB> conf <TAB> location <TAB> note
# Applies a four-way branch per incoming finding:
#   new       → allocate next ID, insert open row
#   open      → keep ID+status, refresh sev/conf/location
#   fixed     → reopen (regression), keep ID, refresh sev/conf/location
#   waived    → leave untouched
# Rows absent from the incoming batch are left untouched.
# Writes the resulting table atomically once at the end.
# Prints "Fn <branch>" for each incoming finding.
#
# ID allocation: cur_max is tracked in-batch so successive new findings in one
# batch get distinct consecutive IDs (F4, F5, …) without re-reading the file.
# Newly allocated rows are also registered in row_lookup so a later entry in
# the same batch can match a key that was just created this run.
# ---------------------------------------------------------------------------
cmd_reconcile() {
  if [ "$#" -ne 1 ]; then usage; exit 1; fi
  local brief_dir="$1"
  local ffile
  ffile=$(findings_file "$brief_dir")

  if [ ! -f "$ffile" ]; then
    echo "error: FINDINGS.md not found in '$brief_dir'; run 'init' first" >&2
    exit 1
  fi

  # Read entire stdin batch FIRST — avoids a subshell losing accumulated state.
  local batch
  batch="$(cat)"

  # Build a newline-delimited key→row lookup string for existing rows.
  # Each line: "<sha1key> TAB <raw_table_row>"
  # Table rows never contain raw tabs, so TAB is unambiguous as a separator.
  local row_lookup=""
  local cur_max=0
  local rrow rkey rid rnum
  while IFS= read -r rrow; do
    rkey=$(row_match_key "$rrow")
    if [ -z "$row_lookup" ]; then
      row_lookup="${rkey}	${rrow}"
    else
      row_lookup="${row_lookup}
${rkey}	${rrow}"
    fi
    rid=$(row_field "$rrow" 2)
    case "$rid" in
      F[0-9]*)
        rnum=${rid#F}
        if [ "$rnum" -gt "$cur_max" ] 2>/dev/null; then
          cur_max="$rnum"
        fi
        ;;
    esac
  done < <(read_data_rows "$brief_dir")

  # Process each incoming finding.
  # We accumulate:
  #   outcomes    — per-finding outcome lines printed at the end
  #   mutations   — lines: "<key> TAB <new_row>"  (for existing rows that change)
  #   new_rows    — newline-delimited list of brand-new rows to append
  # We also extend row_lookup with newly-allocated rows so a later batch entry
  # can detect a duplicate incoming key even if it was just allocated this run.
  local outcomes=""
  local mutations=""
  local new_rows=""
  local in_lens in_sev in_conf in_location in_note
  local in_key matched_row ex_id ex_status ex_enc ex_rebuilt
  local lookup_line lookup_key

  while IFS="	" read -r in_lens in_sev in_conf in_location in_note \
      || [ -n "$in_lens" ]; do
    [ -n "$in_lens" ] || continue

    # Validate enumerated columns for this batch entry.
    validate_sev "$in_sev"
    validate_conf "$in_conf"

    in_key=$(match_key "$in_lens" "$in_location" "$in_note")

    # Encode free-text fields for storage.
    local in_enc_lens in_enc_location in_enc_note
    in_enc_lens=$(encode_note "$in_lens")
    in_enc_location=$(encode_note "$in_location")
    in_enc_note=$(encode_note "$in_note")

    # Linear scan of row_lookup for a matching key.
    matched_row=""
    while IFS= read -r lookup_line; do
      [ -n "$lookup_line" ] || continue
      lookup_key=${lookup_line%%	*}
      if [ "$lookup_key" = "$in_key" ]; then
        matched_row=${lookup_line#*	}
        break
      fi
    done <<LOOKUP_EOF
$row_lookup
LOOKUP_EOF

    if [ -z "$matched_row" ]; then
      # Branch 1: NEW — key not found in existing rows (or prior new rows).
      cur_max=$((cur_max + 1))
      ex_id="F${cur_max}"
      ex_rebuilt="| ${ex_id} | ${in_enc_lens} | ${in_sev} | ${in_conf} | open | ${in_enc_location} | ${in_enc_note} |"
      new_rows="${new_rows}${ex_rebuilt}
"
      # Register in lookup so a duplicate key later in the same batch matches.
      row_lookup="${row_lookup}
${in_key}	${ex_rebuilt}"
      outcomes="${outcomes}${ex_id} new
"
    else
      ex_id=$(row_field "$matched_row" 2)
      ex_status=$(row_field "$matched_row" 6)
      ex_enc=$(row_field "$matched_row" 8)

      case "$ex_status" in
        open)
          # Branch 2: OPEN — refresh sev/conf/location (encoded), keep status+ID+note.
          ex_rebuilt="| ${ex_id} | ${in_enc_lens} | ${in_sev} | ${in_conf} | open | ${in_enc_location} | ${ex_enc} |"
          mutations="${mutations}${in_key}	${ex_rebuilt}
"
          outcomes="${outcomes}${ex_id} recurring
"
          ;;
        fixed)
          # Branch 4: FIXED → reopen (regression); refresh sev/conf/location.
          ex_rebuilt="| ${ex_id} | ${in_enc_lens} | ${in_sev} | ${in_conf} | open | ${in_enc_location} | ${ex_enc} |"
          mutations="${mutations}${in_key}	${ex_rebuilt}
"
          outcomes="${outcomes}${ex_id} reopened
"
          ;;
        waived)
          # Branch 3: WAIVED — leave untouched, do not resurface.
          outcomes="${outcomes}${ex_id} waived-kept
"
          ;;
        *)
          # Unknown status — treat as open/refresh.
          ex_rebuilt="| ${ex_id} | ${in_enc_lens} | ${in_sev} | ${in_conf} | open | ${in_enc_location} | ${ex_enc} |"
          mutations="${mutations}${in_key}	${ex_rebuilt}
"
          outcomes="${outcomes}${ex_id} recurring
"
          ;;
      esac
    fi
  done <<BATCH_EOF
$batch
BATCH_EOF

  # Write the full updated table atomically once.
  # Pass 1: replay existing rows, applying any mutations in-place.
  # Pass 2: append new rows.
  _FINDINGS_TMP="${brief_dir}/.FINDINGS.tmp.$$"

  {
    echo "$HEADER_ROW"
    echo "$SEP_ROW"

    # Emit existing rows, applying mutations where the key appears in mutations.
    local emit_row emit_rkey
    local mut_line mut_key
    while IFS= read -r emit_row; do
      [ -n "$emit_row" ] || continue
      emit_rkey=$(row_match_key "$emit_row")
      # Search mutations for this key.
      local found_mut=""
      while IFS= read -r mut_line; do
        [ -n "$mut_line" ] || continue
        mut_key=${mut_line%%	*}
        if [ "$mut_key" = "$emit_rkey" ]; then
          found_mut=${mut_line#*	}
          break
        fi
      done <<MUT_EOF
$mutations
MUT_EOF
      if [ -n "$found_mut" ]; then
        printf '%s\n' "$found_mut"
      else
        printf '%s\n' "$emit_row"
      fi
    done < <(read_data_rows "$brief_dir")

    # Emit new rows.
    if [ -n "$new_rows" ]; then
      printf '%s' "$new_rows"
    fi
  } > "$_FINDINGS_TMP"
  mv "$_FINDINGS_TMP" "$ffile"
  _FINDINGS_TMP=""

  # Print per-finding outcomes (one line each).
  printf '%s' "$outcomes"
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------
main() {
  if [ "$#" -lt 1 ]; then
    usage
    exit 1
  fi

  local sub="$1"
  shift

  case "$sub" in
    init)
      cmd_init "$@"
      ;;
    add)
      cmd_add "$@"
      ;;
    transition)
      cmd_transition "$@"
      ;;
    waive)
      cmd_waive "$@"
      ;;
    list)
      cmd_list "$@"
      ;;
    count)
      cmd_count "$@"
      ;;
    reconcile)
      cmd_reconcile "$@"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
